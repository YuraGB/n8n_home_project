      "parameters": {
        "jsCode": "const allPosts = $('Fetch customer posts').all()\nconst titles =  $('Loop Over Items')\n  .all()\n  .filter(i => i.json.wasUpdated)\n  .map(elem => \n    allPosts\n      .find(item => item.json.id === elem.json.postId)\n  )\n  .filter(c => c)\n  .map(it => it?.json.name)\n\nconst count = titles.length\n\nreturn [\n  {\n    json: {\n      postTitles: titles, \n      count: count\n    }\n  }\n\n]"
      },
